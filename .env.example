# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign the access token embedded in the session (src/lib/jwt.ts)
JWT_SECRET_KEY=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/schoolmonitoringinventorysystem"

# UploadThing (item photos)
# Copy the token for your app from https://uploadthing.com/dashboard -> API Keys
UPLOADTHING_TOKEN=""

# Resend (e-mails new users their temporary password and a login link)
# Create an API key at https://resend.com/api-keys. EMAIL_FROM must use a domain verified at
# https://resend.com/domains — until then "onboarding@resend.dev" works, but only delivers to
# the e-mail address of your own Resend account.
RESEND_API_KEY=""
EMAIL_FROM="School Property Monitoring System <onboarding@resend.dev>"
# A real, monitored mailbox. Replies go here, and having one helps keep the mail out of spam.
EMAIL_REPLY_TO=""
# Public address of the deployed app, used for the login link in e-mails (falls back to
# NEXTAUTH_URL). Keep it on a real domain: localhost links get mail flagged as spam.
APP_URL=""
