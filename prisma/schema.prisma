// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model names, table names (@@map) and every column name are kept identical to the Sequelize
// app so the JSON reaching the UI is unchanged. Relation fields are deliberately capitalised
// (Item / Member / Room / Borrow) to match the Sequelize association aliases the pages read.

enum Role {
  admin
  faculty
  staff
  student

  @@map("user_role")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(50)
  username  String  @unique @db.VarChar(50)
  password  String  @db.VarChar(255)
  /// School e-mail address. Nullable because accounts created before this column exists have none.
  email     String? @unique @db.VarChar(100)
  /// School ID number of the faculty / staff / admin the account belongs to.
  id_number String? @unique @db.VarChar(50)
  role      Role    @default(admin)
  /// 1=active, 2=inactive
  status    Int     @default(1)

  requestedBorrows BorrowRequest[] @relation("BorrowRequestRequester")
  reviewedBorrows  BorrowRequest[] @relation("BorrowRequestReviewer")
  releasedItems    ItemReceipt[]   @relation("ItemReceiptReleaser")
  inventoryScans   InventoryScan[]
  inventoryScanLog InventoryScanLog[]

  @@map("user")
}

model Borrower {
  id             Int    @id @default(autoincrement())
  m_school_id    String @unique @db.VarChar(50)
  m_fname        String @db.VarChar(50)
  m_lname        String @db.VarChar(50)
  m_gender       String @db.VarChar(10)
  m_contact      String @db.VarChar(20)
  m_department   String @db.VarChar(100)
  m_year_section String @db.VarChar(50)
  /// 1=student, 2=faculty, 3=staff
  m_type         Int
  m_password     String @db.VarChar(255)
  /// 1=active, 2=inactive
  m_status       Int    @default(1)

  borrows        Borrow[]
  returns        Return[]
  borrowRequests BorrowRequest[]

  @@map("borrower")
}

model Item {
  id            Int     @id @default(autoincrement())
  i_deviceID    String  @unique @db.VarChar(50)
  i_model       String  @db.VarChar(100)
  i_category    String  @db.VarChar(50)
  i_brand       String  @db.VarChar(50)
  i_description String  @db.Text
  i_type        String  @db.VarChar(50)
  item_rawstock Int     @default(1)
  /// 1=available, 2=borrowed, 3=maintenance, 4=damaged
  i_status      Int     @default(1)
  i_mr          String  @db.VarChar(50)
  i_price       Decimal @db.Decimal(10, 2)
  i_photo       String  @default("default.jpg") @db.VarChar(255)
  no_of_items   Int?
  remarks       String? @db.Text
  /// Day the school acquired the item. Nullable because items added before this column have none.
  i_date_acquired DateTime? @db.Date

  borrows        Borrow[]
  returns        Return[]
  borrowRequests BorrowRequest[]
  inventoryScans   InventoryScan[]
  inventoryScanLog InventoryScanLog[]

  @@map("item")
}

/// One scanned label in a user's running inventory count (/admin/inventory). Kept on the server
/// so the same account sees the same count on every device; "Clear list" deletes the user's rows.
model InventoryScan {
  id               Int      @id @default(autoincrement())
  user_id          Int
  item_id          Int
  /// Units counted — how many times the label was scanned.
  s_count          Int      @default(1)
  first_scanned_at DateTime @default(now())
  last_scanned_at  DateTime @default(now())

  User User @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Item Item @relation(fields: [item_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([user_id, item_id])
  @@index([user_id, last_scanned_at])
  @@map("inventory_scan")
}

/// Every scan made on /admin/inventory, one row per scan. Unlike `InventoryScan` it is kept when
/// the list is cleared, so the monthly history can show what was counted in any month.
model InventoryScanLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  item_id    Int
  scanned_at DateTime @default(now())

  User User @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Item Item @relation(fields: [item_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  // The history asks for one user's scans within a month.
  @@index([user_id, scanned_at])
  @@map("inventory_scan_log")
}

model Room {
  id            Int      @id @default(autoincrement())
  r_name        String   @db.VarChar(100)
  r_description String?  @db.Text
  /// 1=active, 2=inactive
  r_status      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  borrows        Borrow[]
  returns        Return[]
  borrowRequests BorrowRequest[]

  @@map("room")
}

model Borrow {
  id              Int       @id @default(autoincrement())
  member_id       Int
  item_id         Int
  room_id         Int?
  b_date_borrowed DateTime  @default(now())
  b_date_returned DateTime?
  b_due_date      DateTime
  b_quantity      Int       @default(1)
  /// 1=borrowed, 2=returned, 3=overdue
  b_status        Int       @default(1)
  b_purpose       String?   @db.Text
  b_notes         String?   @db.Text

  Member  Borrower       @relation(fields: [member_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Item    Item           @relation(fields: [item_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Room    Room?          @relation(fields: [room_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
  return  Return?
  /// Set when this row was created by an admin approving a borrow request.
  request BorrowRequest?
  /// Set once the item was physically handed over and the admin logged who took it.
  receipt ItemReceipt?

  @@map("borrow")
}

/// Proof of hand-over: approving a request creates the `Borrow`, but the item is still on the
/// shelf until someone collects it. This records who actually walked away with it — with a photo
/// taken at the counter — so a disputed loan can be traced to a person rather than to an account.
///
/// One row per borrow; a borrow with no row here has been approved but not yet collected.
model ItemReceipt {
  id        Int @id @default(autoincrement())
  borrow_id Int @unique

  /// Name of the person who physically took the item. Usually the borrower, but a colleague or
  /// classmate may collect on their behalf — hence `rc_relationship`.
  rc_receiver_name  String  @db.VarChar(150)
  /// School / employee ID number the receiver presented.
  rc_receiver_id    String? @db.VarChar(50)
  /// Contact number taken at the counter, for chasing an item that is not returned.
  rc_contact        String? @db.VarChar(20)
  /// "self" when the borrower collected it, otherwise how the receiver relates to the borrower.
  rc_relationship   String  @default("self") @db.VarChar(50)
  /// Kind of ID shown at the counter (School ID, Driver's License, ...).
  rc_id_presented   String? @db.VarChar(50)
  /// UploadThing URL of the photo taken as the item was handed over. Nullable because a receipt
  /// with the details filled in is still better than no record when the camera is unavailable.
  rc_receiver_photo String? @db.VarChar(255)

  /// Units actually handed over, which can be fewer than the borrow asked for.
  rc_quantity    Int      @default(1)
  /// Condition of the item at the moment it left, so damage on return can be attributed.
  rc_condition   String   @default("Good") @db.VarChar(50)
  rc_notes       String?  @db.Text
  rc_received_at DateTime @default(now())

  /// `user.id` of the admin who released the item. Nullable so a deleted account does not take
  /// the hand-over record with it.
  released_by Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  Borrow   Borrow @relation(fields: [borrow_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Releaser User?  @relation("ItemReceiptReleaser", fields: [released_by], references: [id], onUpdate: Cascade, onDelete: SetNull)

  // The list is newest-first, and the "awaiting hand-over" tab asks which borrows have no row here.
  @@index([rc_received_at])
  @@map("item_receipt")
}

/// A borrow the faculty / staff / student pages ask for but cannot grant themselves. It holds no
/// stock — the item is only decremented when an admin approves and the matching `Borrow` row is
/// created — so a pile of pending requests never looks like items that are out on loan.
model BorrowRequest {
  id          Int      @id @default(autoincrement())
  member_id   Int
  item_id     Int
  room_id     Int?
  br_quantity Int      @default(1)
  /// Return date the requester is asking for; copied to `Borrow.b_due_date` on approval.
  br_due_date DateTime
  /// 1=pending, 2=approved, 3=rejected
  br_status   Int      @default(1)
  br_purpose  String?  @db.Text

  /// `user.id` of the account that sent the request. Nullable so a deleted account does not
  /// take the request history with it.
  requested_by   Int?
  /// `user.id` of the admin who approved or rejected it.
  reviewed_by    Int?
  br_reviewed_at DateTime?
  /// Admin's note — the reason shown to the requester when a request is rejected.
  br_review_note String?   @db.Text

  /// The `borrow` row this request became, once approved.
  borrow_id Int? @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  Member    Borrower @relation(fields: [member_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Item      Item     @relation(fields: [item_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Room      Room?    @relation(fields: [room_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
  Borrow    Borrow?  @relation(fields: [borrow_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
  Requester User?    @relation("BorrowRequestRequester", fields: [requested_by], references: [id], onUpdate: Cascade, onDelete: SetNull)
  Reviewer  User?    @relation("BorrowRequestReviewer", fields: [reviewed_by], references: [id], onUpdate: Cascade, onDelete: SetNull)

  // The admin bell counts pending requests on every poll, and the list is newest-first.
  @@index([br_status])
  @@index([createdAt])
  @@map("borrow_request")
}

/// Single-row table holding the school's fee policy. The admin edits it on /admin/settings and
/// the returned-items screen uses it to suggest what a borrower owes. Always read/written with
/// `id = 1` — `getFees` falls back to the defaults below when the row does not exist yet.
model FeeSetting {
  id Int @id @default(1)

  /// Amount charged for each day an item is returned past its due date.
  f_overdue_fee_per_day Decimal @default(0.00) @db.Decimal(10, 2)
  /// Days past the due date that are not charged at all.
  f_overdue_grace_days  Int     @default(0)
  /// Ceiling on the total late fee. 0 means no ceiling.
  f_overdue_max_fee     Decimal @default(0.00) @db.Decimal(10, 2)

  /// Damage fee suggested for each return condition offered on the return form.
  f_damage_fee_fair    Decimal @default(0.00) @db.Decimal(10, 2)
  f_damage_fee_damaged Decimal @default(0.00) @db.Decimal(10, 2)
  f_damage_fee_lost    Decimal @default(0.00) @db.Decimal(10, 2)

  /// When true, a lost item is charged at the item's own price instead of `f_damage_fee_lost`.
  f_lost_charge_item_price Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("fee_setting")
}

model Return {
  id              Int      @id @default(autoincrement())
  borrow_id       Int      @unique
  member_id       Int
  item_id         Int
  room_id         Int?
  r_date_returned DateTime @default(now())
  r_quantity      Int      @default(1)
  /// Condition of item when returned (Good, Damaged, Lost, etc.)
  r_condition     String?
  /// Additional notes about the return
  r_notes         String?  @db.Text
  /// Late fee if applicable
  r_late_fee      Decimal  @default(0.00) @db.Decimal(10, 2)
  /// Damage fee if applicable
  r_damage_fee    Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  Borrow Borrow   @relation(fields: [borrow_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Member Borrower @relation(fields: [member_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Item   Item     @relation(fields: [item_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  Room   Room?    @relation(fields: [room_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@index([borrow_id])
  @@index([member_id])
  @@index([item_id])
  @@index([r_date_returned])
  @@map("returns")
}
